    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cspell": "^10.5.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
