    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.6",
    "@vercel/analytics": "^2.0.1",
    "luxon": "^3.7.2",
    "mapbox-gl": "^3.35.2",
    "minotor": "^13.0.1",
    "next": "16.4.6",
    "promise-worker": "^2.0.1",
    "react": "19.3.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-icons": "^5.7.0",
    "react-map-gl": "^8.1.3",
    "rehype-pretty-code": "^0.14.6",
    "shiki": "^4.6.0"
