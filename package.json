{
  "name": "minotor.dev",
  "version": "0.1.0",
  "description": "Documentation and examples for minotor, a lightweight client-side transit router.",
  "keywords": [
    "minotor",
    "raptor",
    "transit",
    "planner",
    "transport",
    "router",
    "gtfs",
    "trains",
    "netex"
  ],
  "private": true,
  "homepage": "https://minotor.dev",
  "bugs": "https://github.com/aubryio/minotor.dev/issues",
  "author": "Aubry Cholleton <aubry@cholleton.com> (https://aubry.io)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aubryio/minotor.dev.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "format": "prettier --write .",
    "spell:check": "cspell \"{README.md,.github/*.md,app/**/*.tsx}\" -u",
